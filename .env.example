# 可选：自托管或代理后的 5etools-cn 根目录
NEXT_PUBLIC_5ETOOLS_BASE_URL=https://raw.githubusercontent.com/tjliqy/5etools-cn/cn2.0
# 可选：逗号分隔的同构镜像；默认仍会加入 jsDelivr 核心库镜像
NEXT_PUBLIC_5ETOOLS_MIRROR_URLS=

# 可选：自托管 Homebrew 根目录与发现清单
NEXT_PUBLIC_HOMEBREW_BASE_URL=https://raw.githubusercontent.com/tjliqy/homebrew/master
NEXT_PUBLIC_HOMEBREW_MANIFEST_URL=https://api.github.com/repos/tjliqy/homebrew/git/trees/master?recursive=1
NEXT_PUBLIC_HOMEBREW_MIRROR_URLS=

# 逗号分隔的自动加载目录。留空使用应用默认目标类别。
NEXT_PUBLIC_HOMEBREW_AUTOLOAD_CATEGORIES=
# collection 目录约 151 MB，默认不自动加载；确认需要后显式开启。
NEXT_PUBLIC_HOMEBREW_INCLUDE_COLLECTIONS=false
